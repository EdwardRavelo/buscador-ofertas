# Copiar este archivo a config/.env y completar. config/.env esta en .gitignore.

# --- Telegram (Fase 5) -------------------------------------------------------
# 1. Abrir Telegram y escribirle a @BotFather
# 2. Enviar /newbot y seguir los pasos; devuelve un token como 8123456789:AAH...
# 3. Escribirle CUALQUIER mensaje al bot recien creado (si no, no puede responderte)
# 4. Abrir en el navegador:
#    https://api.telegram.org/bot<TU_TOKEN>/getUpdates
#    y copiar el numero de "chat":{"id": ...}
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Google Sheets (Fase 2) --------------------------------------------------
# El ID esta en la URL de la planilla:
# https://docs.google.com/spreadsheets/d/ESTE_PEDAZO_ES_EL_ID/edit
GOOGLE_SHEET_ID=
