<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Radar Porteño</title>
<meta name="description" content="Talleres, cursos, festivales y teatro gratis en Buenos Aires, vigilados a diario.">
<meta name="robots" content="noindex">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><text y='14' font-size='14'>📻</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Piazzolla:opsz,wght@8..30,400;8..30,600;8..30,800&display=swap">

<style>
  /* Paleta clara completa: papel frio, acento teal, y un solo tono calido
     reservado para lo recien publicado. */
  :root {
    --ground:    #F5F8F9;
    --surface:   #FFFFFF;
    --sunken:    #ECF1F3;
    --border:    #DBE4E8;
    --hairline:  #E8EEF1;
    --ink:       #101820;
    --muted:     #56666F;
    --faint:     #83959E;
    --accent:    #0A6A87;
    --sobre-acento: #FFFFFF;
    --urgente:   #A6360F;
    --urgente-suave: #FBEAE3;
    --alto:      #14664C;
    --medio:     #855A0B;
    --bajo:      #56666F;
    --sombra:    0 1px 2px rgba(16,24,32,.05), 0 2px 12px rgba(16,24,32,.05);
    --sombra-alta: 0 2px 6px rgba(16,24,32,.07), 0 12px 34px rgba(16,24,32,.09);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --ground:    #0B1116;
      --surface:   #131D24;
      --sunken:    #1A252D;
      --border:    #26343D;
      --hairline:  #1D2931;
      --ink:       #E7EEF2;
      --muted:     #93A5AF;
      --faint:     #6D808B;
      --accent:    #52B7D6;
      --sobre-acento: #07161C;
      --urgente:   #F09070;
      --urgente-suave: #3A1B10;
      --alto:      #5FC49F;
      --medio:     #D5A345;
      --bajo:      #93A5AF;
      --sombra:    0 1px 2px rgba(0,0,0,.35), 0 2px 12px rgba(0,0,0,.25);
      --sombra-alta: 0 2px 6px rgba(0,0,0,.4), 0 12px 34px rgba(0,0,0,.35);
    }
  }
  :root[data-theme="dark"] {
    --ground:    #0B1116;
    --surface:   #131D24;
    --sunken:    #1A252D;
    --border:    #26343D;
    --hairline:  #1D2931;
    --ink:       #E7EEF2;
    --muted:     #93A5AF;
    --faint:     #6D808B;
    --accent:    #52B7D6;
    --sobre-acento: #07161C;
    --urgente:   #F09070;
    --urgente-suave: #3A1B10;
    --alto:      #5FC49F;
    --medio:     #D5A345;
    --bajo:      #93A5AF;
    --sombra:    0 1px 2px rgba(0,0,0,.35), 0 2px 12px rgba(0,0,0,.25);
    --sombra-alta: 0 2px 6px rgba(0,0,0,.4), 0 12px 34px rgba(0,0,0,.35);
  }

  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--ground);
    color: var(--ink);
    font-family: Archivo, "Segoe UI", system-ui, sans-serif;
    font-size: 15px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }
  .envoltorio { max-width: 1080px; margin: 0 auto; padding: 44px 24px 80px; }

  /* --- Encabezado --------------------------------------------------------- */
  .encabezado { display: flex; flex-direction: column; gap: 8px; margin-bottom: 28px; }
  .eyebrow {
    font-size: 11px; font-weight: 700; letter-spacing: .16em;
    text-transform: uppercase; color: var(--accent);
  }
  .encabezado h1 {
    font-family: Piazzolla, Georgia, serif;
    font-optical-sizing: auto;
    font-size: clamp(36px, 6.5vw, 62px);
    font-weight: 800; letter-spacing: -.025em; line-height: .98;
    text-wrap: balance; margin: 0;
  }
  .sello { color: var(--faint); font-size: 13px; margin: 0; }

  /* --- Destacada: la tesis de la pagina ----------------------------------- */
  .destacada {
    display: grid; grid-template-columns: auto 1fr; gap: 26px; align-items: start;
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 5px solid var(--urgente);
    border-radius: 14px; padding: 28px 30px; margin-bottom: 14px;
    box-shadow: var(--sombra-alta);
  }
  .destacada .cifra {
    font-family: Piazzolla, Georgia, serif;
    font-size: 72px; font-weight: 800; line-height: .85; letter-spacing: -.04em;
    color: var(--urgente); font-variant-numeric: tabular-nums;
  }
  .destacada .rotulo {
    font-size: 10.5px; font-weight: 700; letter-spacing: .14em;
    text-transform: uppercase; color: var(--urgente);
    display: block; margin-bottom: 10px;
  }
  .destacada h2 {
    font-family: Piazzolla, Georgia, serif;
    font-size: clamp(21px, 2.9vw, 30px);
    font-weight: 600; line-height: 1.2; letter-spacing: -.012em;
    margin: 0 0 12px; text-wrap: balance;
  }
  .destacada h2 a { color: var(--ink); text-decoration: none; }
  .destacada h2 a:hover { color: var(--accent); }

  /* --- Tira de metricas --------------------------------------------------- */
  .metricas {
    display: flex; flex-wrap: wrap;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 12px; padding: 16px 20px; margin-bottom: 22px;
    box-shadow: var(--sombra);
  }
  .metrica { display: flex; flex-direction: column; padding: 0 28px 0 0; }
  .metrica + .metrica { border-left: 1px solid var(--hairline); padding-left: 28px; }
  .metrica .valor {
    font-family: Piazzolla, Georgia, serif;
    font-size: 30px; font-weight: 800; line-height: 1;
    letter-spacing: -.03em; font-variant-numeric: tabular-nums;
  }
  .metrica .valor.acento { color: var(--accent); }
  .metrica .valor.calor { color: var(--urgente); }
  .metrica .clave {
    font-size: 10px; text-transform: uppercase; letter-spacing: .1em;
    color: var(--faint); font-weight: 700; margin-top: 4px;
  }

  /* --- Controles ---------------------------------------------------------- */
  .controles { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 36px; }
  .control {
    font: inherit; font-size: 13px; font-weight: 600;
    padding: 7px 15px; border-radius: 999px; cursor: pointer;
    background: var(--surface); color: var(--muted);
    border: 1px solid var(--border);
    transition: background .14s ease, color .14s ease, border-color .14s ease;
  }
  .control:hover { border-color: var(--accent); color: var(--ink); }
  .control[aria-pressed="true"] {
    background: var(--accent); border-color: var(--accent); color: var(--sobre-acento);
  }
  .control:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* --- Familia: el agrupamiento que evita la ensalada --------------------- */
  .familia { margin-bottom: 42px; }
  .familia > header {
    display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap;
    padding-bottom: 10px; margin-bottom: 14px;
    border-bottom: 2px solid var(--ink);
  }
  .familia > header h2 {
    font-family: Piazzolla, Georgia, serif;
    font-size: 27px; font-weight: 800; margin: 0; letter-spacing: -.022em;
  }
  .resumen-familia {
    font-size: 12px; color: var(--faint); font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  /* --- Tema: acordeon nativo ---------------------------------------------- */
  .tema {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 11px; margin-bottom: 10px; overflow: hidden;
    box-shadow: var(--sombra);
  }
  .tema[hidden] { display: none; }
  .tema > summary {
    display: flex; align-items: center; gap: 11px;
    padding: 14px 18px; cursor: pointer; list-style: none;
    user-select: none;
  }
  .tema > summary::-webkit-details-marker { display: none; }
  .tema > summary:hover { background: var(--sunken); }
  .tema > summary:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }

  .chevron {
    flex: none; width: 9px; height: 9px; border-right: 2px solid var(--faint);
    border-bottom: 2px solid var(--faint); transform: rotate(-45deg);
    transition: transform .16s ease; margin-left: 2px;
  }
  .tema[open] > summary .chevron { transform: rotate(45deg); }

  .nombre-tema { font-weight: 700; font-size: 15.5px; flex: 1; }
  .cuenta-tema {
    font-size: 12px; color: var(--faint); font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .tope {
    font-family: Piazzolla, Georgia, serif;
    font-size: 19px; font-weight: 800; letter-spacing: -.02em;
    font-variant-numeric: tabular-nums; margin-left: 4px;
  }
  .tope.alto  { color: var(--alto); }
  .tope.medio { color: var(--medio); }
  .tope.bajo  { color: var(--bajo); }

  .cuerpo-tema { padding: 4px 18px 18px; }
  .grilla { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 12px; }

  /* --- Tarjetas ----------------------------------------------------------- */
  .tarjeta {
    display: flex; flex-direction: column; gap: 8px;
    background: var(--ground);
    border: 1px solid var(--border);
    border-left: 4px solid var(--border);
    border-radius: 9px; padding: 15px 17px;
    transition: border-color .16s ease;
  }
  .tarjeta:hover { border-color: var(--accent); }
  .tarjeta[hidden] { display: none; }
  /* El riel izquierdo codifica cuan reciente es la publicacion. */
  .tarjeta.caliente { border-left-color: var(--urgente); }
  .tarjeta.semana   { border-left-color: var(--accent); }

  .fila-superior { display: flex; align-items: center; gap: 9px; }
  .cifra-chica {
    font-family: Piazzolla, Georgia, serif;
    font-size: 25px; font-weight: 800; line-height: 1;
    letter-spacing: -.03em; font-variant-numeric: tabular-nums;
  }
  .cifra-chica.alto  { color: var(--alto); }
  .cifra-chica.medio { color: var(--medio); }
  .cifra-chica.bajo  { color: var(--bajo); }

  .marca {
    font-size: 9.5px; font-weight: 700; letter-spacing: .1em;
    text-transform: uppercase; padding: 3px 8px; border-radius: 999px;
  }
  .marca.nueva { background: var(--accent); color: var(--sobre-acento); }
  .marca.reciente { background: var(--urgente-suave); color: var(--urgente); }

  .tarjeta h3 { font-size: 14.5px; font-weight: 600; line-height: 1.36; margin: 0; }
  .tarjeta h3 a { color: var(--ink); text-decoration: none; }
  .tarjeta h3 a:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
  .tarjeta h3 a:focus-visible,
  .destacada h2 a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 3px; }

  .pie-tarjeta {
    display: flex; flex-wrap: wrap; align-items: center; gap: 6px;
    font-size: 11.5px; color: var(--muted); margin-top: auto; padding-top: 2px;
  }
  .medio { font-weight: 600; color: var(--ink); }
  .punto { color: var(--faint); }
  .senal {
    font-size: 10.5px; padding: 2px 7px; border-radius: 4px;
    background: var(--sunken); color: var(--muted); font-weight: 500;
  }
  .alterno { font-size: 11px; color: var(--faint); text-decoration: none; }
  .alterno:hover { color: var(--accent); text-decoration: underline; }
  .vacio { color: var(--faint); font-size: 13.5px; padding: 6px 2px 10px; }

  .pie {
    margin-top: 46px; padding-top: 20px; border-top: 1px solid var(--border);
    font-size: 12px; color: var(--faint); line-height: 1.65;
  }
  .pie code { background: var(--sunken); padding: 1px 5px; border-radius: 4px; font-size: 11px; }

  @media (max-width: 620px) {
    .envoltorio { padding: 30px 16px 60px; }
    .destacada { grid-template-columns: 1fr; gap: 12px; padding: 22px; }
    .destacada .cifra { font-size: 54px; }
    .metrica { padding-right: 18px; }
    .metrica + .metrica { padding-left: 18px; }
    .grilla { grid-template-columns: 1fr; }
    .cuenta-tema { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; }
  }
</style>
</head>
<body>

<div class="envoltorio">
  <header class="encabezado">
    <span class="eyebrow">Cultura y formación</span>
    <h1>Radar Porteño</h1>
    <p class="sello">Actualizado {{ actualizado }}</p>
  </header>

  {% if destacada %}
  <article class="destacada">
    <div class="cifra">{{ '%.1f'|format(destacada.score) }}</div>
    <div>
      <span class="rotulo">Lo mejor de esta semana</span>
      <h2><a href="{{ destacada.url }}" target="_blank" rel="noopener noreferrer">{{ destacada.titulo }}</a></h2>
      <div class="pie-tarjeta">
        <span class="medio">{{ destacada.fuente }}</span>
        <span class="punto">&middot;</span>
        <span>{{ destacada.edad }}</span>
        {% for m in destacada.motivos[:3] %}<span class="senal">{{ m }}</span>{% endfor %}
        {% if destacada.opaco %}<span class="punto">&middot;</span><a class="alterno" href="{{ destacada.respaldo }}" target="_blank" rel="noopener noreferrer">buscar la nota</a>{% endif %}
      </div>
    </div>
  </article>
  {% endif %}

  <div class="metricas">
    <div class="metrica">
      <span class="valor">{{ total }}</span>
      <span class="clave">en seguimiento</span>
    </div>
    <div class="metrica">
      <span class="valor{% if nuevos %} acento{% endif %}">{{ nuevos }}</span>
      <span class="clave">nuevas hoy</span>
    </div>
    <div class="metrica">
      <span class="valor{% if calientes %} calor{% endif %}">{{ calientes }}</span>
      <span class="clave">recién publicadas</span>
    </div>
    {% for f in familias %}
    <div class="metrica">
      <span class="valor">{{ f.total }}</span>
      <span class="clave">{{ f.nombre }}</span>
    </div>
    {% endfor %}
  </div>

  <div class="controles">
    <button class="control" id="solo-nuevas" aria-pressed="false" type="button">Solo nuevas</button>
    <button class="control" id="abrir-todo" type="button">Abrir todo</button>
    <button class="control" id="cerrar-todo" type="button">Cerrar todo</button>
  </div>

  {% for f in familias %}
  <section class="familia" data-familia="{{ f.nombre }}">
    <header>
      <h2>{{ f.nombre }}</h2>
      <span class="resumen-familia">
        {{ f.total }} en seguimiento{% if f.nuevos %} &middot; {{ f.nuevos }} nueva{{ 's' if f.nuevos != 1 else '' }}{% endif %}
      </span>
    </header>

    {% for t in f.temas %}
    <details class="tema" data-tema="{{ t.clave }}"{% if t.abierto %} open{% endif %}>
      <summary>
        <span class="chevron" aria-hidden="true"></span>
        <span class="nombre-tema">{{ t.nombre }}</span>
        {% if t.nuevos %}<span class="marca nueva">{{ t.nuevos }} nueva{{ 's' if t.nuevos != 1 else '' }}</span>{% endif %}
        <span class="cuenta-tema">{{ t.total }}</span>
        {% if t.mejor %}<span class="tope {{ 'alto' if t.mejor >= 9 else ('medio' if t.mejor >= 8 else 'bajo') }}">{{ '%.1f'|format(t.mejor) }}</span>{% endif %}
      </summary>
      <div class="cuerpo-tema">
        {% if t.ofertas %}
        <div class="grilla">
          {% for o in t.ofertas %}
          <article class="tarjeta {{ o.urgencia }}" data-nuevo="{{ 'si' if o.nuevo else 'no' }}">
            <div class="fila-superior">
              <span class="cifra-chica {{ o.nivel }}">{{ '%.1f'|format(o.score) }}</span>
              {% if o.nuevo %}<span class="marca nueva">nueva</span>{% endif %}
              {% if o.urgencia == 'caliente' %}<span class="marca reciente">recién</span>{% endif %}
            </div>
            <h3><a href="{{ o.url }}" target="_blank" rel="noopener noreferrer">{{ o.titulo }}</a></h3>
            <div class="pie-tarjeta">
              <span class="medio">{{ o.fuente }}</span>
              <span class="punto">&middot;</span>
              <span>{{ o.edad }}</span>
              {% for m in o.motivos[:2] %}<span class="senal">{{ m }}</span>{% endfor %}
              {% if o.opaco %}<span class="punto">&middot;</span><a class="alterno" href="{{ o.respaldo }}" target="_blank" rel="noopener noreferrer">buscar la nota</a>{% endif %}
            </div>
          </article>
          {% endfor %}
        </div>
        {% else %}
        <p class="vacio">Todavía nada para este tema. Se revisa en cada corrida.</p>
        {% endif %}
      </div>
    </details>
    {% endfor %}
  </section>
  {% endfor %}

  <footer class="pie">
    Generado por <code>run.py dashboard</code> y publicado por GitHub Actions.
    El puntaje mide qué tan bien encaja con el tema, no la calidad del curso ni de la obra.
    Las etiquetas de tiempo indican cuándo se <em>publicó</em> la nota, no cuándo cierra la
    inscripción: esa fecha no la tenemos, así que no la inventamos.
    Los enlaces marcados <em>buscar la nota</em> vienen de Google News, que cifra la URL real del medio.
  </footer>
</div>

<script>
  (function () {
    var soloNuevas = document.getElementById('solo-nuevas');
    var abrirTodo = document.getElementById('abrir-todo');
    var cerrarTodo = document.getElementById('cerrar-todo');
    var temas = Array.prototype.slice.call(document.querySelectorAll('.tema'));

    function leer(clave, porDefecto) {
      try {
        var v = localStorage.getItem(clave);
        return v === null ? porDefecto : v;
      } catch (e) {
        return porDefecto;
      }
    }
    function guardar(clave, valor) {
      try { localStorage.setItem(clave, valor); } catch (e) { /* ventana privada */ }
    }

    // Si el usuario ya decidio sobre un tema, su eleccion gana sobre el default
    // del servidor (abierto solo si trae novedades).
    temas.forEach(function (t) {
      var guardado = leer('radar:tema:' + t.dataset.tema, null);
      if (guardado !== null) { t.open = guardado === 'true'; }
      t.addEventListener('toggle', function () {
        guardar('radar:tema:' + t.dataset.tema, String(t.open));
      });
    });

    soloNuevas.setAttribute('aria-pressed', leer('radar:solo-nuevas', 'false'));

    function aplicar() {
      var nuevas = soloNuevas.getAttribute('aria-pressed') === 'true';
      temas.forEach(function (t) {
        var mostradas = 0;
        t.querySelectorAll('.tarjeta').forEach(function (tarjeta) {
          var ok = !nuevas || tarjeta.dataset.nuevo === 'si';
          tarjeta.hidden = !ok;
          if (ok) { mostradas++; }
        });
        // Con el filtro activo, un tema sin resultados desaparece entero.
        t.hidden = nuevas && mostradas === 0;
      });
      document.querySelectorAll('.familia').forEach(function (fam) {
        var vivos = fam.querySelectorAll('.tema:not([hidden])').length;
        fam.hidden = vivos === 0;
      });
    }

    soloNuevas.addEventListener('click', function () {
      var v = this.getAttribute('aria-pressed') !== 'true';
      this.setAttribute('aria-pressed', String(v));
      guardar('radar:solo-nuevas', String(v));
      if (v) { temas.forEach(function (t) { t.open = true; }); }
      aplicar();
    });
    abrirTodo.addEventListener('click', function () {
      temas.forEach(function (t) { t.open = true; });
    });
    cerrarTodo.addEventListener('click', function () {
      temas.forEach(function (t) { t.open = false; });
    });

    aplicar();
  })();
</script>
</body>
</html>
